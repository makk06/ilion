# Copy this file to .env and replace the blank values locally.
# Never commit the real .env file or share its values in issues or chat.
TOUR_API_SERVICE_KEY=
SEOUL_OPEN_API_KEY=
KMA_SERVICE_KEY=
# Set approved per-day ceilings before live calls. Zero disables calls.
# SEOUL_DAILY_LIMIT=-1 means no configured daily cap for citydata_ppltn;
# Seoul's general Open API still limits each request to at most 1,000 rows.
TOUR_API_DAILY_LIMIT=0
SEOUL_DAILY_LIMIT=0
KMA_DAILY_LIMIT=0
# Enable nationwide 03:00 incremental / Sunday 04:00 reconciliation only after estimating calls.
MVP_AUTO_TOUR_SYNC=false
TOUR_SYNC_MAX_PAGES=1
# Optional fixed public-place pilot cohort for bounded daily detail jobs.
# Requires --dev worker and a manifest created by prepare_pilot_cohort.
PILOT_COHORT_MANIFEST=
PILOT_DETAIL_DAILY_PLACES=150
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Public VWorld client credential returned by GET /api/config.
# Restrict its allowed domains/apps in the VWorld console before production use.
VWORLD_API_KEY=

# Nationwide crowd estimation. Limits MUST be the approved account daily quota.
# Zero leaves that provider disabled. Keys remain server-side.
HOLIDAY_SERVICE_KEY=
HOLIDAY_DAILY_LIMIT=0
CROWD_WEATHER_MAX_GRIDS=100
CROWD_ESTIMATION_ENABLED=true
CROWD_DISABLE_TREND_HORIZONS=
# Optional absolute server-local SQLite path, outside OneDrive.
# DJANGO_DB_PATH=D:/server-data/ilion/db.sqlite3

# Pi settings live in deploy.json; secret values are enrolled in deployd Secrets.
# Local development does not start a background collector.
# Required in production: generate a unique, unpredictable value of at least 50 characters.
# Keep the value out of Git, issues, chat, command arguments, and logs.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
# Production-only allowlist: an existing DB migrates only when this matches
# the exact pending migration plan. Leave blank for local development.
DJANGO_MIGRATION_TARGET=
DATA_WORKER_ENABLED=false
TOUR_DETAIL_DAILY_PLACES=150
WEATHER_REGULAR_GRIDS=35
# Static candidate reuse; weather and crowd data are always reloaded.
RECOMMENDATION_CONTEXT_CACHE_SECONDS=300
# Nearby coordinates can share a wider static candidate context; exact distance
# and radius filtering still run for every request.
RECOMMENDATION_CONTEXT_REUSE_KM=1

# 탈퇴 이메일 해시 키. 운영에서는 50자 이상, DJANGO_SECRET_KEY와 다른 값을 쓴다.
WITHDRAWAL_HASH_KEY=
